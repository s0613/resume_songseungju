# Gemini — 기존 에이전트 답변과 문의 초안 구조화에 사용합니다.
GOOGLE_GENERATIVE_AI_API_KEY=
# 선택: 미설정 시 애플리케이션 기본 모델을 사용합니다.
AGENT_MODEL=

# 공개 API rate limit 식별자를 HMAC 처리하는 독립 키입니다.
# 다른 서비스의 API 키를 재사용하지 말고, 32바이트 이상의 무작위 값을 사용합니다.
RATE_LIMIT_HASH_KEY=

# Supabase 서버 연결 — service role key는 브라우저에 노출하면 안 됩니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 문의 검토 토큰 서명용 32바이트 이상의 독립 키입니다.
# SMTP 비밀번호를 대신 사용하지 않습니다.
INQUIRY_REVIEW_SECRET=

# 배포된 사이트의 canonical origin입니다. 예: https://example.com
NEXT_PUBLIC_SITE_URL=

# Gmail SMTP — totaro_web과 같은 변수 이름/값을 이 앱에도 별도로 설정합니다.
# 일반 계정 비밀번호가 아닌 Google 앱 비밀번호를 사용합니다.
SMTP_USER=
SMTP_PASS=
